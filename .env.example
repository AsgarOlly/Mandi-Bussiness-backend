# Fruit Mandi ERP Environment Configuration Template
# Duplicate this file to .env and fill in real production values.
# NEVER commit .env to source control!

SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=
FRONTEND_URL=
CORS_ALLOWED_ORIGINS=

# Database Configuration (MySQL)
USE_SQLITE=False
DB_NAME=fruit_erp_db
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Admin Initialization (optional, for manage.py setup_admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
